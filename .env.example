# Supabase (Project Settings > API). The service role key is secret: server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local: http://127.0.0.1:3000/api/auth/callback  (Spotify rejects "localhost")
# Production: https://YOUR-APP.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Generate each with: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# Your timezone decides where "a day" starts and ends (IANA name)
USER_TIMEZONE=America/New_York

# Optional but recommended after your first login: your Spotify user ID
ALLOWED_SPOTIFY_ID=
